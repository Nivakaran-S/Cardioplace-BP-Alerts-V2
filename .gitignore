# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.ruff_cache/
.pytest_cache/

# Virtual environments and secrets
.venv
.env

# Raw HEMOBP corpus (~262 MB) IS committed, through Git LFS -- see .gitattributes, which
# routes data/*.csv through the LFS filter so the pointers land in git and the blobs land in
# LFS storage. Without that filter vip.csv alone would put a 251 MB object into every clone's
# history permanently. Anyone cloning needs `git lfs install` before the files resolve.

# Pipeline outputs. All reproducible from `python main.py`.
Artifacts/
logs/
# `final_model/*` and not `final_model/`: git cannot re-include a file whose parent
# DIRECTORY is excluded, so the trailing-slash form would make the negation below silently
# do nothing. Excluding the contents instead leaves the directory itself visible.
final_model/*
cache/
mlruns/
*.joblib
*.pkl
# write-then-rename leaves these behind only if a run is killed mid-save
*.tmp

# Local Claude Code tool-permission state, not project configuration.
.claude/

# The promoted serving bundle, tracked through LFS so a fresh checkout can serve without a
# six-hour training run. This must be the LAST word on the subject: gitignore is
# last-match-wins, and both `final_model/*` above and the blanket `*.pkl` would otherwise
# beat it. Verified with `git check-ignore -v final_model/model.pkl`.
!final_model/model.pkl
